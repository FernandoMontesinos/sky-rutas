# Copia este archivo como  .env.local  y rellena los valores de tu proyecto Supabase.
# Los encuentras en: Supabase Dashboard -> Project Settings -> Data API  /  API Keys

# URL del proyecto (ej: https://abcdxyz.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública "anon" (publishable). Es segura para el navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave "service_role" (SECRETA). Solo se usa en el servidor para crear usuarios.
# NUNCA la expongas en el navegador ni la subas a git.
SUPABASE_SERVICE_ROLE_KEY=
